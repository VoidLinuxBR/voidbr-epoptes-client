# Maintainer: Vilmar Catafesta <vcatafesta@gmail.com>

pkgname=chili-epoptes-client
# o repositorio no GitHub continua com o nome voidbr-*
_reponame=voidbr-epoptes-client
pkgver=20261124.0237
pkgrel=1
pkgdesc='An opensource computer lab management and monitoring tool (com suporte a thumbshots em Wayland: Hyprland/wlroots, GNOME, KDE Plasma)'
arch=(any)
url="https://github.com/voidlinuxbr/${_reponame}"
license=(GPL-3.0-or-later)
depends=(
	dbus
	gobject-introspection
	grim
	gtk3
	iperf
	iproute2
	librsvg
	openssl
	procps-ng
	python
	python-cairo
	python-gobject
	python-pillow
	screen
	socat
	spectacle
	tigervnc
	wayvnc
	x11vnc
	xorg-xprop
	xorg-xset
	xorg-xwininfo
	xterm
)
makedepends=(git patch)
# So o que o lado cliente usa (base: debian/control do Epoptes oficial, mais
# o suporte a Wayland). Twisted, netifaces, pyOpenSSL, libfaketime e
# notification-daemon sao do servidor e sairam daqui.
# grim      -> thumbshots em Hyprland/Sway/river/labwc (wlroots)
# wayvnc    -> observar/assistir (duplo-clique) em Hyprland/Sway/wlroots
# spectacle -> thumbshots em KDE Plasma Wayland
# GNOME nao precisa de pacote extra: usa gdbus, que ja vem com glib.
# xorg-xprop/xset/xwininfo, x11vnc, tigervnc e xterm -> sessoes X11.
provides=(epoptes-client)
conflicts=(epoptes-client)
backup=(etc/default/epoptes-client)
# Automatically detect and use the correct install file
if [ -e "${pkgname}.install" ]; then
	install=${pkgname}.install
elif [ -e "pkgbuild.install" ]; then
	install=pkgbuild.install
fi
# O .patch e o mesmo do pkgfile/ (Void): aqui e um link simbolico para
# ../pkgfile/voidbr-epoptes-client.patch, para manter uma unica copia.
source=(
	"${pkgname}::git+${url}.git"
	"voidbr-epoptes-client.patch"
)
sha256sums=(
	'SKIP'
	'b42b83a5fc8bfc26c6a40d50024ffb30ad32fb8ac1d85d6e77ccd2c8c1cb04f0'
)

pkgver() {
	cd "$pkgname"
	git log -1 --format=%cd --date=format:%Y%m%d.%H%M
}

prepare() {
	cd "$pkgname"
	# VoidBR patch (o mesmo do pacote Void, gerado com ./gera-patch.sh):
	# - thumbshot.py: miniaturas em Wayland - grim (wlroots) /
	#   gdbus+Shell.Screenshot (GNOME) / spectacle (KDE). O caminho X11
	#   original permanece intocado.
	# - epoptes-client --check: diagnostico (arquivos, nome do servidor,
	#   certificado, conexoes e miniatura).
	# - epoptes-client: avisa no log quando o certificado do servidor mudou
	#   e nao desiste mais quando o nome do servidor ainda nao resolve.
	# O client-functions (observar/assistir em Wayland) vem do SERVIDOR na
	# conexao; esse e o patch do pacote chili-epoptes.
	patch -p1 < "$srcdir/voidbr-epoptes-client.patch"
}

package() {
	cd "${srcdir}/${pkgname}"
	# Modelo Chili (chili-xfce-config): tudo vai para /usr/share/${pkgname}
	# no pacote e o pkgbuild.install copia para / no post_install
	# (sh_copy_user_etc_usr_opt_files do pkgbuildlib.sh).
	install -dm755 "${pkgdir}/usr/share/${pkgname}"
	local dirs=("usr" "etc" "opt")
	for dir in "${dirs[@]}"; do
		if [ -d "${srcdir}/${pkgname}/${dir}" ]; then
			cp -a "${srcdir}/${pkgname}/${dir}" "${pkgdir}/usr/share/${pkgname}/"
		fi
	done

	local stage="${pkgdir}/usr/share/${pkgname}"
	# etc/sv e do runit (Void); no Arch o servico vem das units do systemd.
	rm -rf "${stage}/etc/sv"
	# No Arch /usr/sbin e link para /usr/bin (pacote filesystem): copiar
	# uma pasta usr/sbin por cima dele falha. A unit do systemd e o
	# autostart chamam /usr/sbin/epoptes-client, que resolve pelo link.
	install -Dm755 "${stage}/usr/sbin/epoptes-client" "${stage}/usr/bin/epoptes-client"
	rm -rf "${stage}/usr/sbin"
	# etc/default fica como arquivo do pacman (backup=), fora da copia do
	# post_install, para o upgrade nao sobrescrever a configuracao local.
	rm -rf "${stage}/etc/default"
	install -Dm644 "etc/default/epoptes-client" "${pkgdir}/etc/default/epoptes-client"
	find "${stage}" -type d -name __pycache__ -prune -exec rm -rf {} +

	# Install license file if present
	if [ -f "LICENSE" ]; then
		install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	fi

	# Install documentation if present
	if [ -f "README.md" ]; then
		install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
	fi
}
