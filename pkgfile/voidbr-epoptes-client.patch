+# VoidBR patch: impressao digital (sha256) do certificado que o servidor
+# apresenta agora; vazio se nao conectou. Usa timeout para nao travar quando
+# o servidor (ou a VPN) ainda nao esta de pe.
+server_fingerprint() {
+    timeout 5 openssl s_client -connect "$SERVER:$PORT" </dev/null 2>/dev/null |
+        sed '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/!d' |
+        openssl x509 -noout -fingerprint -sha256 2>/dev/null
+}
+
+local_fingerprint() {
+    openssl x509 -noout -fingerprint -sha256 -in "$servercrt" 2>/dev/null
+}
+
+# VoidBR patch: quando o servidor e reinstalado ele gera um certificado novo,
+# e o cliente com o antigo so falha no TLS, em silencio, para sempre. Avisa
+# no log (svlogd/journal do root, ~/.xsession-errors da sessao) como resolver.
+check_certificate() {
+    local remote
+
+    remote=$(server_fingerprint)
+    test -n "$remote" || return 0
+    if [ "$remote" != "$(local_fingerprint)" ]; then
+        echo "epoptes-client WARNING: the certificate of $SERVER:$PORT changed" \
+            "(server reinstalled?). Run as root: epoptes-client -c," \
+            "then restart the epoptes-client service and the session." >&2
+    fi
+}
+
+check_ok() {
+    echo "  [OK]    $*"
+}
+
+check_fail() {
+    echo "  [FALHA] $1"
+    test -n "$2" && echo "          -> $2"
+    check_failures=$((check_failures + 1))
+}
+
+# VoidBR patch: epoptes-client --check, diagnostico em uma saida so.
+run_check() {
+    local dir missing f remote conns err me procs summary mypids mycount
+
+    check_failures=0
+    dir=/usr/share/epoptes-client
+    echo "Diagnostico do epoptes-client (servidor $SERVER:$PORT, uid $UID)"
+
+    missing=
+    for f in _common.py endsession get-display lock.svg lock_screen.py \
+        message.py receive-terminals remote_assistance.py \
+        remote_assistance.ui share-terminal thumbshot.py; do
+        test -e "$dir/$f" || missing="$missing $f"
+    done
+    if [ -z "$missing" ]; then
+        check_ok "arquivos de $dir completos"
+    else
+        check_fail "faltam arquivos em $dir:$missing" \
+            "reinstale o pacote do cliente (xbps-install -f / pacman -S)"
+    fi
+
+    if [ -z "$(echo "$SERVER" | tr -d '0-9.')" ] ||
+        getent hosts "$SERVER" >/dev/null; then
+        check_ok "o nome $SERVER resolve: $(getent hosts "$SERVER" | awk '{ print $1; exit }')"
+    else
+        check_fail "o nome $SERVER nao resolve" \
+            "ajuste SERVER= em /etc/default/epoptes-client ou o /etc/hosts"
+    fi
+
+    if [ -s "$servercrt" ]; then
+        check_ok "certificado local em $servercrt"
+    else
+        check_fail "nao existe $servercrt" "rode como root: epoptes-client -c"
+    fi
+
+    remote=$(server_fingerprint)
+    if [ -z "$remote" ]; then
+        check_fail "nao conectou em $SERVER:$PORT" \
+            "servidor desligado, servico epoptes parado, firewall ou rede/VPN"
+    elif [ "$remote" != "$(local_fingerprint)" ]; then
+        check_fail "o certificado do servidor e diferente do local" \
+            "rode como root: epoptes-client -c, e reinicie o servico e a sessao"
+    else
+        check_ok "o servidor responde e o certificado confere"
+    fi
+
+    # Cada conexao do epoptes-client e um processo socat. Ele existe mesmo
+    # enquanto ainda tenta conectar (tenta de novo a cada 60 s), por isso
+    # conta os processos, e nao so as conexoes ja estabelecidas.
+    me=$(id -un)
+    procs=$(ps --sort=start_time -eo user:32=,pid=,args= |
+        grep "[o]penssl-connect:$SERVER:$PORT")
+    summary=$(echo "$procs" | awk 'NF { c[$1]++ }
+        END { for (u in c) printf "%s(%d) ", u, c[u] }')
+    conns=$(ss -Htn state established "( dport = :$PORT )" 2>/dev/null | wc -l)
+    echo "  [INFO]  processos por usuario: ${summary:-nenhum}; conexoes estabelecidas: $conns"
+    mypids=$(echo "$procs" | awk -v u="$me" '$1 == u { print $2 }')
+    mycount=$(echo "$mypids" | grep -c .)
+    if [ "$mycount" -eq 0 ]; then
+        if [ "$UID" -eq 0 ]; then
+            check_fail "nenhum processo epoptes-client do root" \
+                "reinicie o servico epoptes-client"
+        else
+            check_fail "nenhum processo epoptes-client da sua sessao ($me)" \
+                "encerre a sessao e entre de novo, ou rode: epoptes-client &"
+        fi
+    elif [ "$mycount" -gt 1 ]; then
+        # O mais antigo vem primeiro (--sort=start_time); os outros sobram.
+        check_fail "$mycount processos epoptes-client de $me (duplicados)" \
+            "mantenha o mais antigo e encerre os outros: kill $(echo "$mypids" | tail -n +2 | tr '\n' ' ')"
+    else
+        # ss -p so mostra o PID dos proprios processos, o que basta aqui.
+        if ss -Htnp state established "( dport = :$PORT )" 2>/dev/null |
+            grep -q "pid=$mypids,"; then
+            check_ok "a conexao de $me esta estabelecida (PID $mypids)"
+        else
+            check_fail "o processo de $me (PID $mypids) ainda nao conectou" \
+                "ele tenta de novo a cada 60 s; aguarde e rode o --check de novo"
+        fi
+    fi
+
+    if [ "$UID" -eq 0 ]; then
+        echo "  [INFO]  rode tambem como usuario, na sessao grafica, para testar a miniatura"
+    elif [ -n "$WAYLAND_DISPLAY" ] || [ -n "$DISPLAY" ]; then
+        if err=$(cd "$dir" && ./thumbshot.py 16 12 2>&1 >/dev/null); then
+            check_ok "miniatura (thumbshot) funciona nesta sessao"
+        else
+            check_fail "miniatura (thumbshot) falhou" \
+                "$(echo "$err" | tail -n 1)"
+        fi
+    else
+        echo "  [INFO]  sem sessao grafica (DISPLAY/WAYLAND_DISPLAY): miniatura nao testada"
+    fi
+
+    if [ "$check_failures" -eq 0 ]; then
+        echo "Tudo certo."
+    else
+        echo "$check_failures problema(s) encontrado(s)."
+    fi
+    exit "$check_failures"
+}
