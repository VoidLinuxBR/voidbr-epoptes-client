+# Cria uma "conexao reversa" para um servidor VNC que so sabe escutar
+# (como o wayvnc), replicando o que x11vnc -connect_or_exit faz nativamente:
+# o wayvnc sobe escutando so em localhost, e o socat disca pro servidor
+# (equivalente a "$1" = host:porta do Epoptes) fazendo o bridge dos bytes.
+# Parametros:
+# $1 = host:port do servidor (o "${GUI_IP}:porta" que o Epoptes manda).
+# $2 = "viewonly" (observar, sem controlar) ou "assist" (com controle).
+wayland_reverse_vnc() {
+    local target="$1" mode="$2" wport wpid spid
+
+    if ! which wayvnc >/dev/null 2>&1; then
+        echo "wayland_reverse_vnc: wayvnc nao encontrado, instale o pacote wayvnc" >&5
+        return 1
+    fi
+    if ! which socat >/dev/null 2>&1; then
+        echo "wayland_reverse_vnc: socat nao encontrado" >&5
+        return 1
+    fi
+
+    # Porta livre em localhost, escolhida pelo proprio kernel (porta 0).
+    wport=$(python3 -c '
+import socket
+s = socket.socket()
+s.bind(("127.0.0.1", 0))
+print(s.getsockname()[1])
+s.close()
+' 2>/dev/null)
+    if [ -z "$wport" ]; then
+        echo "wayland_reverse_vnc: nao consegui escolher uma porta livre" >&5
+        return 1
+    fi
+
+    if [ "$mode" = viewonly ]; then
+        wpid=$(background -p wayvnc -d 127.0.0.1 "$wport")
+    else
+        wpid=$(background -p wayvnc 127.0.0.1 "$wport")
+    fi
+
+    # Da um tempo pro wayvnc comecar a escutar antes do socat tentar.
+    sleep 0.3
+
+    spid=$(background -p socat "TCP:$target" "TCP:127.0.0.1:$wport")
+
+    xprop_set EPOPTES_WAYVNC_PID "$wpid"
+    xprop_set EPOPTES_VNCVIEWER_PID "$spid"
+}
+
