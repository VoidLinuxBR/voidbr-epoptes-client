+
+def _capture_kde(png_path):
+    """KDE Plasma/KWin via spectacle em modo background (sem dialogo)."""
+    if not _which("spectacle"):
+        raise RuntimeError("spectacle nao encontrado (necessario para KDE)")
+    subprocess.run(
+        ["spectacle", "-b", "-n", "-o", png_path],
