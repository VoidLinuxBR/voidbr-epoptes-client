+def _capture_gnome(png_path):
+    """GNOME/Mutter via a interface D-Bus privada do Shell (sem portal)."""
+    if not _which("gdbus"):
+        raise RuntimeError("gdbus nao encontrado (necessario para GNOME)")
+    subprocess.run(
