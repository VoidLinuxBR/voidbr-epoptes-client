+def _capture_wlroots(png_path):
+    """Hyprland, Sway, river, labwc... via wlr-screencopy (protocolo)."""
+    if not _which("grim"):
+        raise RuntimeError("grim nao encontrado (necessario para wlroots)")
+    subprocess.run(["grim", png_path], check=True, timeout=10)
