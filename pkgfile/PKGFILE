pkgname=voidbr-epoptes-client
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
pkgdesc='An opensource computer lab management and monitoring tool (com suporte a thumbshots em Wayland: Hyprland/wlroots, GNOME, KDE Plasma)'
replaces=(epoptes-client)
makedepends=(git python3-distutils-extra intltool patch)
url="https://github.com/voidlinuxbr/$pkgname"
source=(
	"git+${url}.git"
	"voidbr-epoptes-client.patch"
)
license=(GPL3)
arch=(any)
sha256sums=(
	'SKIP'
	'4ee77b8a1bf392343f8a8afcf358cb1699414eb3b25c07ca1459665c921d0829'
)
depends=(
	dbus
	gobject-introspection
	grim
	gtk+3
	iperf
	iproute2
	librsvg
	openssl
	procps-ng
	python3-cairo
	python3-gobject
	python3-Pillow
	screen
	socat
	spectacle
	tigervnc
	wayvnc
	x11vnc
	xprop
	xset
	xterm
	xwininfo
)
# So o que o lado cliente usa (base: debian/control do Epoptes oficial, mais
# o suporte a Wayland). Twisted, netifaces, pyOpenSSL, faketime e
# notification-daemon sao do servidor e sairam daqui.
# grim      -> thumbshots em Hyprland/Sway/river/labwc (wlroots)
# wayvnc    -> observar/assistir (duplo-clique) em Hyprland/Sway/wlroots
# spectacle -> thumbshots em KDE Plasma Wayland
# GNOME com Wayland usa pacotes do proprio GNOME, que NAO entram aqui
# (pesados e so uteis em clientes GNOME; sem eles o servidor avisa):
#   gnome-remote-desktop     -> observar/assistir
#   libsecret (secret-tool)  -> senha do observar/assistir
#   xdg-desktop-portal-gnome -> thumbshots (portal de captura)
# xprop/xset/xwininfo, x11vnc, tigervnc e xterm -> sessoes X11.
# Void/xbps nao tem optdepends, entao tudo fica como dependencia.
backup=(/etc/default/epoptes-client)

prepare() {
	cd "${srcdir}/${pkgname}"
	# VoidBR patch (gerado com ./gera-patch.sh, na raiz do repositorio):
	# - thumbshot.py: miniaturas em Wayland - grim (wlroots) /
	#   portal de captura (GNOME) / spectacle (KDE). O caminho X11
	#   original permanece intocado.
	# - epoptes-client --check: diagnostico (arquivos, nome do servidor,
	#   certificado, conexoes e miniatura).
	# - epoptes-client: avisa no log quando o certificado do servidor mudou
	#   (servidor reinstalado) e nao desiste mais quando o nome do servidor
	#   ainda nao resolve (VPN subindo depois da rede no boot/login).
	# O client-functions (observar/assistir em Wayland) vem do SERVIDOR na
	# conexao; esse e o patch do pacote voidbr-epoptes.
	patch -p1 < "${srcdir}/voidbr-epoptes-client.patch"
}

package() {
	local dirs=("usr" "etc" "opt")
	#   echo "DESTDIR=$DESTDIR"
	#   echo "pkgdir=$pkgdir"
	#   echo "srcdir=$srcdir"
	#   echo "_pkgsrc=$_pkgsrc"
	cd ${srcdir}/${pkgname}
	for dir in "${dirs[@]}"; do
		if [ -d "${_pkgsrc}/${dir}" ]; then
			cp -a "${_pkgsrc}/${dir}" "$DESTDIR/"
		fi
	done
}
pre_install() {
	log "Iniciando instalação"
}
post_install() {
  pkgname="epoptes-client"
  if ! getent group epoptes >/dev/null; then
    groupadd epoptes >/dev/null || true
    echo "Group 'epoptes' has been added."
  fi
  usermod -aG epoptes "$user" >/dev/null || true
  mkdir -p /etc/epoptes/ >/dev/null || true
  ln -sf /etc/sv/epoptes-client /var/service/ >/dev/null || true
  log "A instalação foi concluída. Antes de utilizar o Epoptes, lembre-se de fazer o seguinte:"
  log "1.- Você deverá adicionar seu usuário ao grupo 'epoptes' - ${YELLOW}sudo usermod -aG epoptes $user"
  log "2.- Você deverá executar como root:"
  log "    ${YELLOW}'vservice enable epoptes-client' ${CYAN}para habilitar o serviço de cliente Epoptes."
  log "3.- Pode ser necessário reiniciar o sistema para que tudo funcione corretamente."
  log "4.- Se não quiser reiniciar o sistema, após realizar todos os passos acima, execute como root:"
  log "    ${YELLOW}'vservice start epoptes-client' ${CYAN}para iniciar o serviço do cliente Epoptes."
  log "Após concluir tudo isso, você ainda precisará encerrar a sessão e entrar novamente."
  log "Feito isso, o Epoptes deverá funcionar normalmente.${RESET}"
  log "Observar/assistir clientes (duplo-clique) em Wayland: so funciona em"
  log "Hyprland/Sway e outros compositores wlroots por enquanto."
  log "Se algo nao funcionar, rode ${YELLOW}epoptes-client --check${CYAN} como usuario,"
  log "num terminal da sessao grafica, para ver o diagnostico.${RESET}"
}
pre_upgrade() {
	log "Iniciando upgrade"
}
post_upgrade() {
	log "Finalizando upgrade"
}
