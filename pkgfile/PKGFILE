pkgname=voidbr-epoptes-client
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
pkgdesc='An opensource computer lab management and monitoring tool (com suporte a thumbshots em Wayland: Hyprland/wlroots, GNOME, KDE Plasma)'
replaces=(epoptes-client)
makedepends=(git python3-distutils-extra intltool patch)
url="https://github.com/voidlinuxbr/$pkgname"
source=(
	"git+${url}.git"
	"voidbr-epoptes-client.patch"
)
license=(GPL3)
arch=(any)
sha256sums=(
	'SKIP'
	'3c34317a25eb345fb8f4789cf939b3dec79d60ff6db957c360db5c637f1fe2b4'
)
depends=(gobject-introspection
	grim
	gtk+3
	iperf
	iproute2
	faketime
	kde-cli-tools
	libnotify
	librsvg
	notification-daemon
	openssl
	python3-cairo
	python3-dbus
	python3-gobject
	python3-netifaces
	python3-openssl
	python3-Pillow
	python3-service_identity
	python3-Twisted
	socat
	tigervnc
	wayvnc
	x11vnc
	xterm
)
# grim   -> thumbshots em Hyprland/Sway/river/labwc (wlroots)
# wayvnc -> observar/assistir (duplo-clique) em Hyprland/Sway/wlroots
# kde-cli-tools (spectacle) -> thumbshots em KDE Plasma Wayland
# GNOME nao precisa de pacote extra: usa gdbus, que ja vem com glib
# (dependencia transitiva de gtk+3). Void/xbps nao tem optdepends, entao
# esses ficam como dependencia obrigatoria mesmo, ainda que so facam
# sentido em alguns ambientes.
backup=(/etc/default/epoptes-client)

prepare() {
	cd "${srcdir}/${pkgname}"
	# VoidBR patch: suporte a Wayland (Hyprland/wlroots, GNOME, KDE Plasma)
	# - thumbshots: grim (wlroots) / gdbus+Shell.Screenshot (GNOME) /
	#   spectacle (KDE). O caminho X11 original permanece intocado.
	# - observar/assistir (duplo-clique): wayvnc + socat fazendo o papel
	#   de "conexao reversa" que o wayvnc nao tem nativamente (so
	#   funciona em Hyprland/Sway/wlroots; sem efeito em GNOME/KDE ainda).
	# - gui.py: fix Python 3.14 (modulo "pipes" removido, virou "shlex").
	patch -p1 < "${srcdir}/voidbr-epoptes-client.patch"
}

package() {
	local dirs=("usr" "etc" "opt")
	#   echo "DESTDIR=$DESTDIR"
	#   echo "pkgdir=$pkgdir"
	#   echo "srcdir=$srcdir"
	#   echo "_pkgsrc=$_pkgsrc"
	cd ${srcdir}/${pkgname}
	for dir in "${dirs[@]}"; do
		if [ -d "${_pkgsrc}/${dir}" ]; then
			cp -a "${_pkgsrc}/${dir}" "$DESTDIR/"
		fi
	done
}
pre_install() {
	log "Iniciando instalação"
}
post_install() {
  pkgname="epoptes-client"
  if ! getent group epoptes >/dev/null; then
    groupadd epoptes >/dev/null || true
    echo "Group 'epoptes' has been added."
  fi
  usermod -aG epoptes "$user" >/dev/null || true
  mkdir -p /etc/epoptes/ >/dev/null || true
  ln -sf /etc/sv/epoptes-client /var/service/ >/dev/null || true
  log "A instalação foi concluída. Antes de utilizar o Epoptes, lembre-se de fazer o seguinte:"
  log "1.- Você deverá adicionar seu usuário ao grupo 'epoptes' - ${YELLOW}sudo usermod -aG epoptes $user"
  log "2.- Você deverá executar como root:"
  log "    ${YELLOW}'vservice enable epoptes-client' ${CYAN}para habilitar o serviço de cliente Epoptes."
  log "3.- Pode ser necessário reiniciar o sistema para que tudo funcione corretamente."
  log "4.- Se não quiser reiniciar o sistema, após realizar todos os passos acima, execute como root:"
  log "    ${YELLOW}'vservice start epoptes-client' ${CYAN}para iniciar o serviço do cliente Epoptes."
  log "Após concluir tudo isso, você ainda precisará encerrar a sessão e entrar novamente."
  log "Feito isso, o Epoptes deverá funcionar normalmente.${RESET}"
  log "Thumbshots em Wayland: em Hyprland/Sway instale o pacote 'grim'; em KDE"
  log "Plasma instale 'kde-cli-tools' (spectacle). GNOME nao precisa de nada extra."
  log "Observar/assistir clientes (duplo-clique) em Wayland: so funciona em"
  log "Hyprland/Sway por enquanto, instale o pacote 'wayvnc'."
}
pre_upgrade() {
	log "Iniciando upgrade"
}
post_upgrade() {
	log "Finalizando upgrade"
}
